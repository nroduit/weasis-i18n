<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>org.weasis</groupId>
	<artifactId>weasis-i18n</artifactId>
	<version>5.0.0</version>
	<packaging>pom</packaging>
	<name>Weasis Internationalization</name>

	<properties>
		<java-version>21</java-version>
		<jdk-version>21</jdk-version>
		<enforcer.jdk-version>[${jdk-version},)</enforcer.jdk-version>
		<enforcer.maven-version>[3.6.3,)</enforcer.maven-version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

		<dollarSign>$</dollarSign>
		<build-transifex-plugin.version>1.4.0</build-transifex-plugin.version>
	</properties>

	<licenses>
		<license>
			<name>Eclipse Public License v2.0</name>
			<url>https://www.eclipse.org/legal/epl-v20.html</url>
			<distribution>repo</distribution>
		</license>
	</licenses>
	<scm>
		<connection>scm:git:https://github.com/nroduit/weasis-i18n.git</connection>
		<developerConnection>scm:git:https://github.com/nroduit/weasis-i18n.git</developerConnection>
		<url>https://github.com/nroduit/weasis-i18n</url>
	</scm>

	<!-- Override for getting snapshot -->
	<repositories>
		<repository>
			<id>central</id>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
			<name>Central Repository</name>
			<url>https://repo.maven.apache.org/maven2</url>
		</repository>
		<repository>
			<id>mvn-repo-master</id>
			<url>https://raw.github.com/nroduit/mvn-repo/master/</url>
		</repository>
	</repositories>

	<pluginRepositories>
		<!-- Force to use central first (override from super POM) -->
		<pluginRepository>
			<releases>
				<updatePolicy>never</updatePolicy>
			</releases>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
			<id>central</id>
			<name>Central Repository</name>
			<url>https://repo.maven.apache.org/maven2</url>
		</pluginRepository>
		<pluginRepository>
			<id>mvn-repo-master</id>
			<url>https://raw.github.com/nroduit/mvn-repo/master/</url>
		</pluginRepository>
	</pluginRepositories>

	<modules>
		<module>weasis-core-i18n</module>
		<module>weasis-base-explorer-i18n</module>
		<module>weasis-base-ui-i18n</module>
		<module>weasis-base-viewer2d-i18n</module>
		<module>weasis-dicom-au-i18n</module>
		<module>weasis-dicom-codec-i18n</module>
		<module>weasis-dicom-explorer-i18n</module>
		<module>weasis-dicom-isowriter-i18n</module>
		<module>weasis-dicom-qr-i18n</module>
		<module>weasis-dicom-rt-i18n</module>
		<module>weasis-dicom-send-i18n</module>
		<module>weasis-dicom-sr-i18n</module>
		<module>weasis-dicom-viewer2d-i18n</module>
		<module>weasis-dicom-viewer3d-i18n</module>
		<module>weasis-dicom-wave-i18n</module>
		<module>weasis-acquire-editor-i18n</module>
		<module>weasis-acquire-explorer-i18n</module>
		<module>weasis-launcher-i18n</module>
		<module>weasis-i18n-dist</module>
	</modules>
	<build>
		<finalName>${project.artifactId}</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<version>3.7.0</version>
				<executions>
					<execution>
						<id>min-requirement</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireMavenVersion>
									<version>${enforcer.maven-version}</version>
								</requireMavenVersion>
								<requireJavaVersion>
									<version>${enforcer.jdk-version}</version>
								</requireJavaVersion>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.2.0</version>
				<executions>
					<execution>
						<id>clean.build.number</id>
						<inherited>false</inherited>
						<phase>clean</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<delete file="weasis-i18n-dist/src/buildNumber.properties" />
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.16.0</version>
				<configuration>
					<release>${java-version}</release>
				</configuration>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<plugin>
					<!-- Every module that declares antrun removes, before its jar is built, the downloaded
					     translations that break a rule of TranslationChecks (printf placeholder, invalid
					     MessageFormat pattern, lone apostrophe): Weasis then shows English for these keys
					     instead of a broken string. The translations of the weasis Transifex project still
					     follow the 4.x sources (%s where 5.0 has {0}). The root pom has no classes folder,
					     the program skips it. -->
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-antrun-plugin</artifactId>
					<version>3.2.0</version>
					<executions>
						<execution>
							<id>drop-invalid-translations</id>
							<phase>prepare-package</phase>
							<goals>
								<goal>run</goal>
							</goals>
							<configuration>
								<target>
									<exec executable="java" failonerror="true">
										<arg value="${maven.multiModuleProjectDirectory}/weasis-i18n-dist/src/check/TranslationChecks.java" />
										<arg value="--drop" />
										<arg value="${project.build.directory}/classes" />
									</exec>
								</target>
							</configuration>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<artifactId>maven-assembly-plugin</artifactId>
					<version>3.8.0</version>
					<configuration>
						<descriptors>
							<descriptor>src/assembly/dist.xml</descriptor>
						</descriptors>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>buildnumber-maven-plugin</artifactId>
					<version>3.3.1</version>
					<executions>
						<execution>
							<phase>validate</phase>
							<goals>
								<goal>create</goal>
							</goals>
						</execution>
					</executions>
					<configuration>
						<doCheck>false</doCheck>
						<doUpdate>false</doUpdate>
						<!-- OSGI version qualifier ::= (alpha|digit|'_'|'-')+ -->
						<!-- digit ::= [0..9] -->
						<!-- alpha ::= [a..zA..Z] -->
						<format>{0,date,yyyy-MM-dd_HH-mm-ss-SSS}</format>
						<items>
							<item>timestamp</item>
						</items>
					</configuration>
				</plugin>
				<plugin>
					<!-- Download translations from transifex -->
					<groupId>org.weasis.maven</groupId>
					<artifactId>build-transifex-plugin</artifactId>
					<version>${build-transifex-plugin.version}</version>
					<executions>
						<execution>
							<id>download</id>
							<goals>
								<goal>buildLanguagePacks</goal>
							</goals>
							<configuration>
								<baseURL>https://rest.api.transifex.com/</baseURL>
								<organization>weasis</organization>
								<project>weasis</project>
								<outputDirectory>${project.build.directory}/classes/${bundle.package}</outputDirectory>
								<modules>
									<module>${project.artifactId}</module>
								</modules>
							</configuration>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-jar-plugin</artifactId>
					<version>3.5.1</version>
				</plugin>
				<plugin>
					<groupId>org.weasis.maven</groupId>
					<artifactId>build-xz-plugin</artifactId>
					<version>1.1.0</version>
					<executions>
						<execution>
							<id>xz</id>
							<phase>package</phase>
							<goals>
								<goal>packFiles</goal>
							</goals>
							<configuration>
								<archiveDirectory>${project.build.directory}</archiveDirectory>
								<includes>
									<include>*.jar</include>
								</includes>
							</configuration>
						</execution>
					</executions>
					<dependencies>
						<dependency>
							<groupId>org.codehaus.plexus</groupId>
							<artifactId>plexus-utils</artifactId>
							<version>4.1.0</version>
						</dependency>
					</dependencies>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<dependencies>
		<dependency>
			<groupId>org.weasis.maven</groupId>
			<artifactId>build-transifex-plugin</artifactId>
			<version>${build-transifex-plugin.version}</version>
		</dependency>
	</dependencies>
</project>
